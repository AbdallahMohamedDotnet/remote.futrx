# Managed by infra/install.sh. Exactly two managed names: the platform and
# its wildcard. App/project creation never changes TLS configuration.
${HOSTNAME} {
    encode zstd gzip
    @internal path /internal/*
    handle @internal {
        respond 403
    }
    reverse_proxy 127.0.0.1:${SERVICE_PORT}
}

*.${HOSTNAME} {
    encode zstd gzip
    tls {
        # Administrator-selected DNS provider and provider-specific options.
        import /etc/caddy/remote-dns.caddy
    }

    @launcherHost header_regexp launcherHost Host (?i)^code\.${HOSTNAME_RE}\.?(?::[0-9]+)?$
    handle @launcherHost {
        # Admin-session gate (same check as the rest of the platform).
        forward_auth 127.0.0.1:${SERVICE_PORT} {
            uri /auth/verify
        }
        # Futrx IDE launcher PWA shell (one origin => one installable app).
        handle / {
            root * ${INSTALL_DIR}/infra/launcher
            file_server
        }
        @launcher path /index.html /manifest.webmanifest /sw.js /icon.svg /favicon.ico
        handle @launcher {
            root * ${INSTALL_DIR}/infra/launcher
            file_server
        }
        # Project list for the launcher (backend, session cookie intact).
        handle /api/* {
            reverse_proxy 127.0.0.1:${SERVICE_PORT}
        }
        # /<slug>/* -> that project's own per-container code-server. Same origin
        # as the launcher, so the whole thing installs as a single PWA and each
        # workspace opens in its own window. The slug prefix is stripped;
        # code-server uses relative asset paths so it works under the sub-path.
        @ide path_regexp ide ^/(?P<slug>[a-z0-9][a-z0-9-]+)(?P<rest>/.*)$
        handle @ide {
            rewrite * {re.ide.rest}
            reverse_proxy {re.ide.slug}.lxd:8842 {
                transport http {
                    keepalive off
                }
                # Strip the platform admin-session cookies before entering the
                # container (forward_auth already validated on loopback).
                header_up Cookie `(?:^|;\s*)(?:remote_session|remote_2fa_pending|remote_oauth_state|return_to)=[^;]*` ""
            }
        }
        # Bare /<slug> -> add trailing slash so code-server's relative URLs resolve.
        @bare path_regexp bare ^/([a-z0-9][a-z0-9-]+)$
        redir @bare {uri}/ 308
        handle {
            respond "Not found" 404
        }
    }

    @preview header_regexp preview Host (?i)^dev--([a-z0-9][a-z0-9-]*)--(\d{4,5})\.${HOSTNAME_RE}\.?(?::[0-9]+)?$
    handle @preview {
        route {
            forward_auth 127.0.0.1:${SERVICE_PORT} {
                uri /auth/verify
            }
            handle /internal/* {
                respond 403
            }
            handle /__remote_inspector {
                reverse_proxy 127.0.0.1:${SERVICE_PORT}
            }
            handle {
                reverse_proxy {re.preview.1}.lxd:{re.preview.2} {
                    # Authorization ran above; container code must not receive platform cookies.
                    header_up Cookie `(?:^|;\s*)(?:remote_session|remote_2fa_pending|remote_oauth_state|return_to)=[^;]*` ""
                }
            }
        }
    }

    # Named apps: <label>--<project>.<host>. Unnamed: app--<id>--instance.<host>.
    # The gateway authorizes each request and rejects unknown application hosts.
    handle {
        reverse_proxy 127.0.0.1:${SERVICE_PORT}
    }
}
