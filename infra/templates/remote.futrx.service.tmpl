[Unit]
Description=remote.futrx — self-hosted agent chat UI
After=network.target

[Service]
ExecStart=${REMOTE_CLI_PATH}
WorkingDirectory=${INSTALL_DIR}
Environment=HOST=127.0.0.1
Environment=PORT=${SERVICE_PORT}
Environment=HOME=/root
Environment=PATH=${HOST_CLI_BIN_DIR}:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
# tmux server inherits this cgroup; KillMode=process keeps long-running
# child processes (claude, codex, lxc exec) alive during a backend restart.
KillMode=process
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
