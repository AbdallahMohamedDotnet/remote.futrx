# Host toolchain pins — the single place to declare what versions the
# server itself runs. infra/steps/01-host-deps.sh sources this file and
# converges the box to these exact pins on every run (install and update
# are the same idempotent script: bump a pin, re-run, every box upgrades).
#
# Agent CLI pins (Claude Code, Codex, Kimi Code) live separately in
# backend/internal/agent/provisioning/agent-cli-versions.env because the
# backend embeds them for in-container runtime self-healing; step 01
# sources that file too for the host-side CLI installs.

# NodeSource major stream (latest minor within it).
NODE_MAJOR=22
# Minimum required by the pinned Claude Code and Kimi Code packages.
NODE_MIN_VERSION=22.19.0

# Exact upstream tarball, installed to /usr/local/go.
GO_VERSION=1.25.0
